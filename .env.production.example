# ==============================================================================
# AMU Dedicated Store & Resource Management System
# Production Environment Variables (Railway / Cloud Deployment)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Core Server Configuration (Backend)
# ------------------------------------------------------------------------------
NODE_ENV=production
# Railway assigns PORT automatically. Default fallback is 3000.
PORT=3000

# ------------------------------------------------------------------------------
# 2. Database (PostgreSQL)
# ------------------------------------------------------------------------------
# In Railway: When you attach a PostgreSQL plugin, use the reference:
# DATABASE_URL=${{Postgres.DATABASE_URL}}
DATABASE_URL=postgresql://uerp:YOUR_STRONG_PASSWORD@postgres:5432/university_erp?schema=public

# ------------------------------------------------------------------------------
# 3. Redis (Cache, Token Revocation, Rate Limiting)
# ------------------------------------------------------------------------------
# In Railway: When you attach a Redis plugin, use the reference:
# REDIS_URL=${{Redis.REDIS_URL}}
# Or host/port fallback:
# REDIS_HOST=${{Redis.REDISHOST}}
# REDIS_PORT=${{Redis.REDISPORT}}
# REDIS_PASSWORD=${{Redis.REDISPASSWORD}}
REDIS_URL=redis://default:YOUR_REDIS_PASSWORD@redis:6379

# ------------------------------------------------------------------------------
# 4. Authentication (JWT Secrets & Expirations)
# ------------------------------------------------------------------------------
# Generate strong 64-character random strings (e.g. using openssl rand -hex 32)
JWT_ACCESS_SECRET=replace_with_a_very_long_secure_random_string_for_access_tokens_32chars_min
JWT_ACCESS_EXPIRES_IN=1d
JWT_REFRESH_SECRET=replace_with_a_very_long_secure_random_string_for_refresh_tokens_32chars_min
JWT_REFRESH_EXPIRES_IN=7d

# ------------------------------------------------------------------------------
# 5. Database Auto-Migration & Seeding Settings
# ------------------------------------------------------------------------------
# Set AUTO_SEED=true to automatically populate university departments, categories,
# and initial user accounts on the first deployment.
AUTO_SEED=true

# Set ALLOW_DEFAULT_SEED_PASSWORDS=true if deploying to a testing or demo environment
# to use the standard documented demo passwords.
# If false, you MUST set the 5 individual SEED_*_PASSWORD variables below.
ALLOW_DEFAULT_SEED_PASSWORDS=true

# Optional: Custom individual passwords for the 5 seeded roles (if ALLOW_DEFAULT_SEED_PASSWORDS is not true)
# SEED_ADMIN_PASSWORD=Admin#AMU2026!SecureKey
# SEED_MANAGER_PASSWORD=Manager#AMU2026!StoreKey
# SEED_KEEPER_PASSWORD=Keeper#AMU2026!InventoryKey
# SEED_AUDITOR_PASSWORD=Auditor#AMU2026!AuditKey
# SEED_REQUESTER_PASSWORD=Requester#AMU2026!StaffKey

# ------------------------------------------------------------------------------
# 6. CORS (Cross-Origin Resource Sharing)
# ------------------------------------------------------------------------------
# Comma-separated list of allowed frontend origins (e.g. your Railway frontend domain)
# Railway domains ending in .up.railway.app are automatically permitted by default.
CORS_ORIGIN=https://your-frontend.up.railway.app

# ------------------------------------------------------------------------------
# 7. Frontend Environment Variables (Set in Frontend Service Settings)
# ------------------------------------------------------------------------------
# Set this in your Frontend service on Railway (or .env for frontend build):
# Points to the public URL of your backend service.
# VITE_API_BASE_URL=https://your-backend.up.railway.app
