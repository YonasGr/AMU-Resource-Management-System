# Application
NODE_ENV=development
PORT=3000

# Database
DATABASE_URL="postgresql://uerp:uerp_dev_password@localhost:5432/university_erp?schema=public"

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# JWT
JWT_ACCESS_SECRET=change_me_access_secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change_me_refresh_secret
JWT_REFRESH_EXPIRES_IN=7d

# CORS (comma-separated allowed origins)
CORS_ORIGINS=http://localhost:5173,http://localhost:8080

# Demo Accounts Lockdown (Required in production)
SEED_ADMIN_PASSWORD=Admin#AMU2026!SecureKey
SEED_MANAGER_PASSWORD=Manager#AMU2026!StoreKey
SEED_KEEPER_PASSWORD=Keeper#AMU2026!InventoryKey
SEED_REQUESTER_PASSWORD=Requester#AMU2026!StaffKey
SEED_AUDITOR_PASSWORD=Auditor#AMU2026!AuditKey
