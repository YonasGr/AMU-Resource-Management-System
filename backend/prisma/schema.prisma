// Prisma schema for the University ERP system.
// Phase 1.1 adds the first real model: OrganizationUnit — the dynamic org
// tree every other module (Store, User, Request routing) hangs off of.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum OrganizationUnitType {
  UNIVERSITY
  COLLEGE
  DEPARTMENT
  OFFICE
  BUREAU
  DIRECTORATE
  UNIT
}

enum OrganizationUnitStatus {
  ACTIVE
  INACTIVE
}

model OrganizationUnit {
  id     String                 @id @default(uuid())
  name   String
  type   OrganizationUnitType
  status OrganizationUnitStatus @default(ACTIVE)

  parentId String?            @map("parent_id")
  parent   OrganizationUnit?  @relation("OrganizationHierarchy", fields: [parentId], references: [id])
  children OrganizationUnit[] @relation("OrganizationHierarchy")

  users User[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([parentId])
  @@map("organization_units")
}

enum UserStatus {
  ACTIVE
  INACTIVE
}

model User {
  id           String     @id @default(uuid())
  fullName     String     @map("full_name")
  email        String     @unique
  phone        String?
  passwordHash String     @map("password_hash")
  status       UserStatus @default(ACTIVE)

  organizationId String           @map("organization_id")
  organization   OrganizationUnit @relation(fields: [organizationId], references: [id])

  refreshTokens       RefreshToken[]
  passwordResetTokens PasswordResetToken[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([organizationId])
  @@map("users")
}

// One row per issued refresh token so any single session/device can be
// revoked (logout) without invalidating every other session, and so token
// rotation can detect reuse of an already-rotated token.
model RefreshToken {
  id        String    @id @default(uuid())
  tokenHash String    @unique @map("token_hash")
  userId    String    @map("user_id")
  user      User      @relation(fields: [userId], references: [id])
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime  @default(now()) @map("created_at")

  @@index([userId])
  @@map("refresh_tokens")
}

model PasswordResetToken {
  id        String    @id @default(uuid())
  tokenHash String    @unique @map("token_hash")
  userId    String    @map("user_id")
  user      User      @relation(fields: [userId], references: [id])
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  @@index([userId])
  @@map("password_reset_tokens")
}
