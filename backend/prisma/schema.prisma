generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMINISTRATOR
  STORE_MANAGER
  STOREKEEPER
  AUDITOR
  REQUESTER
}

enum UserStatus {
  ACTIVE
  INACTIVE
}

model Department {
  id          String   @id @default(uuid())
  code        String   @unique
  name        String
  description String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  users            User[]
  employees        Employee[]
  materialRequests MaterialRequest[]
  transactions     InventoryTransaction[]

  @@map("departments")
}

model User {
  id           String     @id @default(uuid())
  fullName     String     @map("full_name")
  email        String     @unique
  phone        String?
  passwordHash String     @map("password_hash")
  role         Role       @default(REQUESTER)
  status       UserStatus @default(ACTIVE)

  departmentId String?     @map("department_id")
  department   Department? @relation(fields: [departmentId], references: [id])

  submittedRequests MaterialRequest[]      @relation("Requester")
  approvedRequests  MaterialRequest[]      @relation("ApprovedBy")
  issuedTransactions InventoryTransaction[] @relation("IssuedBy")
  approvedTransactions InventoryTransaction[] @relation("ApprovedBy")
  auditLogs         AuditLog[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("users")
}

model Employee {
  id           String     @id @default(uuid())
  employeeCode String     @unique @map("employee_code")
  fullName     String     @map("full_name")
  email        String?
  phone        String?
  position     String?

  departmentId String     @map("department_id")
  department   Department @relation(fields: [departmentId], references: [id])

  transactions InventoryTransaction[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("employees")
}

enum SupplierStatus {
  ACTIVE
  INACTIVE
}

model Supplier {
  id            String         @id @default(uuid())
  supplierCode  String         @unique @map("supplier_code")
  name          String
  contactPerson String?        @map("contact_person")
  email         String?
  phone         String?
  address       String?
  status        SupplierStatus @default(ACTIVE)

  transactions InventoryTransaction[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("suppliers")
}

model MaterialCategory {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  materials Material[]

  @@map("material_categories")
}

enum MaterialStatus {
  ACTIVE
  INACTIVE
}

model Material {
  id           String         @id @default(uuid())
  materialCode String         @unique @map("material_code")
  name         String
  unit         String         // e.g. Box, Piece, Pack, Ream, Roll
  minimumStock Int            @default(5) @map("minimum_stock")
  location     String?        // Shelf / Rack location e.g. "Shelf A-12"
  barcode      String?        @unique
  description  String?
  status       MaterialStatus @default(ACTIVE)

  categoryId String           @map("category_id")
  category   MaterialCategory @relation(fields: [categoryId], references: [id])

  stockSummary StockSummary?
  requestItems MaterialRequestItem[]
  transactions InventoryTransaction[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("materials")
}

// Stores calculated stock levels for real-time tracking
model StockSummary {
  id                String   @id @default(uuid())
  materialId        String   @unique @map("material_id")
  material          Material @relation(fields: [materialId], references: [id], onDelete: Cascade)
  quantityReceived  Int      @default(0) @map("quantity_received")
  quantityIssued    Int      @default(0) @map("quantity_issued")
  remainingQuantity Int      @default(0) @map("remaining_quantity")
  updatedAt         DateTime @updatedAt @map("updated_at")

  @@map("stock_summaries")
}

enum RequestStatus {
  PENDING
  APPROVED
  REJECTED
  ISSUED
  CANCELLED
}

model MaterialRequest {
  id            String        @id @default(uuid())
  requestNumber String        @unique @map("request_number")
  purpose       String
  status        RequestStatus @default(PENDING)
  managerRemarks String?      @map("manager_remarks")

  requesterId String @map("requester_id")
  requester   User   @relation("Requester", fields: [requesterId], references: [id])

  departmentId String     @map("department_id")
  department   Department @relation(fields: [departmentId], references: [id])

  approvedById String?   @map("approved_by_id")
  approvedBy   User?     @relation("ApprovedBy", fields: [approvedById], references: [id])
  approvedAt   DateTime? @map("approved_at")

  items        MaterialRequestItem[]
  transactions InventoryTransaction[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("material_requests")
}

model MaterialRequestItem {
  id                String          @id @default(uuid())
  requestId         String          @map("request_id")
  request           MaterialRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  materialId        String          @map("material_id")
  material          Material        @relation(fields: [materialId], references: [id])
  quantityRequested Int             @map("quantity_requested")
  quantityIssued    Int             @default(0) @map("quantity_issued")

  @@map("material_request_items")
}

enum TransactionType {
  STOCK_IN
  STOCK_OUT
  RETURN
  ADJUSTMENT
  TRANSFER
}

model InventoryTransaction {
  id              String          @id @default(uuid())
  transactionCode String          @unique @map("transaction_code")
  type            TransactionType
  quantity        Int
  unitPrice       Decimal?        @map("unit_price") @db.Decimal(12, 2)
  purpose         String?
  remarks         String?

  materialId String   @map("material_id")
  material   Material @relation(fields: [materialId], references: [id])

  requestId String?          @map("request_id")
  request   MaterialRequest? @relation(fields: [requestId], references: [id])

  supplierId String?   @map("supplier_id")
  supplier   Supplier? @relation(fields: [supplierId], references: [id])

  employeeId String?   @map("employee_id")
  employee   Employee? @relation(fields: [employeeId], references: [id])

  departmentId String?     @map("department_id")
  department   Department? @relation(fields: [departmentId], references: [id])

  issuedById String? @map("issued_by_id")
  issuedBy   User?   @relation("IssuedBy", fields: [issuedById], references: [id])

  approvedById String? @map("approved_by_id")
  approvedBy   User?   @relation("ApprovedBy", fields: [approvedById], references: [id])

  createdAt DateTime @default(now()) @map("created_at")

  @@map("inventory_transactions")
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String?  @map("user_id")
  user      User?    @relation(fields: [userId], references: [id])
  action    String
  module    String
  details   String?
  ipAddress String?  @map("ip_address")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("audit_logs")
}
