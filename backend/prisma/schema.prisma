generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMINISTRATOR
  STORE_MANAGER
  STOREKEEPER
  AUDITOR
  REQUESTER
}

enum ScopeType {
  GLOBAL
  ORGANIZATION
  STORE
}

enum StoreStatus {
  ACTIVE
  INACTIVE
}

enum UserStatus {
  PENDING_APPROVAL
  ACTIVE
  INACTIVE
}

model Department {
  id          String   @id @default(uuid())
  code        String   @unique
  name        String
  description String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  users            User[]
  employees        Employee[]
  materialRequests MaterialRequest[]
  transactions     InventoryTransaction[]
  stores           Store[]

  @@map("departments")
}

model Store {
  id           String          @id @default(uuid())
  code         String          @unique
  name         String
  location     String?
  status       StoreStatus     @default(ACTIVE)
  departmentId String?         @map("department_id")
  department   Department?     @relation(fields: [departmentId], references: [id])
  users        User[]
  requests     MaterialRequest[]
  stockBalances StockBalance[]
  transactions InventoryTransaction[] @relation("TransactionStore")
  outgoingTransfers InventoryTransfer[] @relation("TransferSource")
  incomingTransfers InventoryTransfer[] @relation("TransferDestination")
  goodsReceipts GoodsReceipt[]
  cycleCounts CycleCount[]
  materialReturns MaterialReturn[]
  purchaseOrders PurchaseOrder[]
  createdAt    DateTime        @default(now()) @map("created_at")
  updatedAt    DateTime        @updatedAt @map("updated_at")

  @@map("stores")
}

model User {
  id           String     @id @default(uuid())
  fullName     String     @map("full_name")
  email        String     @unique
  employeeCode String?    @unique @map("employee_code")
  phone        String?
  passwordHash String     @map("password_hash")
  role         Role       @default(REQUESTER)
  status       UserStatus @default(ACTIVE)
  scopeType    ScopeType  @default(STORE) @map("scope_type")
  requestedTransfers InventoryTransfer[] @relation("TransferRequester")
  dispatchedTransfers InventoryTransfer[] @relation("TransferDispatcher")
  receivedTransfers InventoryTransfer[] @relation("TransferReceiver")
  cancelledTransfers InventoryTransfer[] @relation("TransferCanceller")
  createdGoodsReceipts GoodsReceipt[] @relation("ReceiptCreator")
  inspectedGoodsReceipts GoodsReceipt[] @relation("ReceiptInspector")
  postedGoodsReceipts GoodsReceipt[] @relation("ReceiptPoster")
  createdCycleCounts CycleCount[] @relation("CycleCountCreator")
  approvedCycleCounts CycleCount[] @relation("CycleCountApprover")
  createdMaterialReturns MaterialReturn[] @relation("ReturnCreator")
  inspectedMaterialReturns MaterialReturn[] @relation("ReturnInspector")
  postedMaterialReturns MaterialReturn[] @relation("ReturnPoster")
  createdPurchaseOrders PurchaseOrder[] @relation("PurchaseOrderCreator")
  approvedPurchaseOrders PurchaseOrder[] @relation("PurchaseOrderApprover")

  departmentId String?     @map("department_id")
  department   Department? @relation(fields: [departmentId], references: [id])

  storeId      String?     @map("store_id")
  store        Store?      @relation(fields: [storeId], references: [id])

  submittedRequests MaterialRequest[]      @relation("Requester")
  approvedRequests  MaterialRequest[]      @relation("ApprovedBy")
  cancelledRequests MaterialRequest[]     @relation("CancelledBy")
  handedOverRequests MaterialRequest[]    @relation("HandedOverBy")
  confirmedRequests MaterialRequest[]     @relation("ConfirmedBy")
  issuedTransactions InventoryTransaction[] @relation("IssuedBy")
  approvedTransactions InventoryTransaction[] @relation("ApprovedBy")
  auditLogs         AuditLog[]
  notifications     Notification[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("users")
}

model Employee {
  id           String     @id @default(uuid())
  employeeCode String     @unique @map("employee_code")
  fullName     String     @map("full_name")
  email        String?
  phone        String?
  position     String?

  departmentId String     @map("department_id")
  department   Department @relation(fields: [departmentId], references: [id])

  transactions InventoryTransaction[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("employees")
}

enum SupplierStatus {
  ACTIVE
  INACTIVE
}

model Supplier {
  id            String         @id @default(uuid())
  supplierCode  String         @unique @map("supplier_code")
  name          String
  contactPerson String?        @map("contact_person")
  email         String?
  phone         String?
  address       String?
  status        SupplierStatus @default(ACTIVE)

  transactions InventoryTransaction[]
  goodsReceipts GoodsReceipt[]
  purchaseOrders PurchaseOrder[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("suppliers")
}

model MaterialCategory {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  materials Material[]

  @@map("material_categories")
}

enum MaterialStatus {
  ACTIVE
  INACTIVE
}

enum UnitCategory {
  COUNT
  MASS
  VOLUME
  LENGTH
  AREA
  PACKAGE
  OTHER
}

enum InventoryCondition {
  NEW
  GOOD
  DAMAGED
  QUARANTINED
  SCRAPPED
}

enum PurchaseOrderStatus {
  DRAFT
  SUBMITTED
  APPROVED
  REJECTED
  PARTIALLY_RECEIVED
  RECEIVED
  CANCELLED
}

model Material {
  id                     String         @id @default(uuid())
  materialCode           String         @unique @map("material_code")
  name                   String
  unit                   String         // Declared stock unit shown to operators.
  unitCategory           UnitCategory   @default(COUNT) @map("unit_category")
  baseUnit               String         @default("piece") @map("base_unit")
  conversionFactorToBase Int            @default(1) @map("conversion_factor_to_base")
  allowsFractional       Boolean        @default(false) @map("allows_fractional")
  requiresLotTracking    Boolean        @default(false) @map("requires_lot_tracking")
  requiresExpiryTracking Boolean        @default(false) @map("requires_expiry_tracking")
  requiresSerialTracking Boolean        @default(false) @map("requires_serial_tracking")
  minimumStock           Int            @default(5) @map("minimum_stock")
  location               String?        // Shelf / Rack location e.g. "Shelf A-12"
  barcode                String?        @unique
  description            String?
  status                 MaterialStatus @default(ACTIVE)
  purchaseOrderLines     PurchaseOrderLine[]

  categoryId String           @map("category_id")
  category   MaterialCategory @relation(fields: [categoryId], references: [id])

  stockSummary StockSummary?
  stockBalances StockBalance[]
  requestItems MaterialRequestItem[]
  transactions InventoryTransaction[]
  transfers InventoryTransfer[]
  goodsReceipts GoodsReceipt[]
  cycleCountLines CycleCountLine[]
  materialReturns MaterialReturn[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("materials")
}

// Stores calculated stock levels for real-time tracking
model StockSummary {
  id                String   @id @default(uuid())
  materialId        String   @unique @map("material_id")
  material          Material @relation(fields: [materialId], references: [id], onDelete: Cascade)
  quantityReceived  Int      @default(0) @map("quantity_received")
  quantityIssued    Int      @default(0) @map("quantity_issued")
  remainingQuantity Int      @default(0) @map("remaining_quantity")
  updatedAt         DateTime @updatedAt @map("updated_at")

  @@map("stock_summaries")
}

model StockBalance {
  id                String   @id @default(uuid())
  storeId           String   @map("store_id")
  store             Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  materialId        String   @map("material_id")
  material          Material @relation(fields: [materialId], references: [id], onDelete: Cascade)
  quantityReceived  Int      @default(0) @map("quantity_received")
  quantityIssued    Int      @default(0) @map("quantity_issued")
  remainingQuantity Int      @default(0) @map("remaining_quantity")
  reservedQuantity  Int      @default(0) @map("reserved_quantity")
  updatedAt         DateTime @updatedAt @map("updated_at")

  @@unique([storeId, materialId])
  @@index([materialId])
  @@index([storeId, materialId])
  @@map("stock_balances")
}

enum RequestStatus {
  PENDING
  APPROVED
  PARTIALLY_ISSUED
  BACKORDERED
  REJECTED
  ISSUED
  CANCELLED
  CLOSED
}

model MaterialRequest {
  id            String        @id @default(uuid())
  requestNumber String        @unique @map("request_number")
  purpose       String
  status        RequestStatus @default(PENDING)
  managerRemarks String?      @map("manager_remarks")

  requesterId String @map("requester_id")
  requester   User   @relation("Requester", fields: [requesterId], references: [id])

  departmentId String     @map("department_id")
  department   Department @relation(fields: [departmentId], references: [id])

  storeId      String?    @map("store_id")
  store        Store?     @relation(fields: [storeId], references: [id])

  approvedById String?   @map("approved_by_id")
  approvedBy   User?     @relation("ApprovedBy", fields: [approvedById], references: [id])
  approvedAt   DateTime? @map("approved_at")
  cancelledById String?   @map("cancelled_by_id")
  cancelledBy   User?     @relation("CancelledBy", fields: [cancelledById], references: [id])
  cancelledAt   DateTime? @map("cancelled_at")
  cancellationReason String? @map("cancellation_reason")
  handoverEvidence String? @map("handover_evidence")
  handedOverById String? @map("handed_over_by_id")
  handedOverBy   User? @relation("HandedOverBy", fields: [handedOverById], references: [id])
  handedOverAt   DateTime? @map("handed_over_at")
  confirmedById  String? @map("confirmed_by_id")
  confirmedBy    User? @relation("ConfirmedBy", fields: [confirmedById], references: [id])
  confirmedAt    DateTime? @map("confirmed_at")
  closedAt       DateTime? @map("closed_at")

  items        MaterialRequestItem[]
  transactions InventoryTransaction[]
  materialReturns MaterialReturn[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("material_requests")
}

model RequestNumberCounter {
  year       Int      @id
  nextNumber Int      @default(1) @map("next_number")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@map("request_number_counters")
}

model MaterialRequestItem {
  id                String          @id @default(uuid())
  requestId         String          @map("request_id")
  request           MaterialRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  materialId        String          @map("material_id")
  material          Material        @relation(fields: [materialId], references: [id])
  quantityRequested Int             @map("quantity_requested")
  quantityIssued    Int             @default(0) @map("quantity_issued")
  quantityReserved  Int             @default(0) @map("quantity_reserved")
  quantityReturned  Int             @default(0) @map("quantity_returned")
  transactions      InventoryTransaction[]
  materialReturns   MaterialReturn[]

  @@map("material_request_items")
}

enum TransactionType {
  STOCK_IN
  STOCK_OUT
  RETURN
  ADJUSTMENT
  TRANSFER
}

enum TransferStatus {
  DRAFT
  DISPATCHED
  RECEIVED
  CANCELLED
}

enum ReceiptStatus {
  DRAFT
  INSPECTED
  POSTED
  REJECTED
}

enum CycleCountStatus {
  DRAFT
  COUNTED
  APPROVED
  RECOUNT_REQUIRED
  CANCELLED
}

enum MaterialReturnStatus {
  DRAFT
  INSPECTED
  POSTED
  CANCELLED
}

enum ReturnDisposition {
  ACCEPT_TO_STOCK
  QUARANTINE
  SCRAP
}

model CycleCount {
  id          String          @id @default(uuid())
  countCode   String          @unique @map("count_code")
  storeId     String          @map("store_id")
  store       Store            @relation(fields: [storeId], references: [id])
  status      CycleCountStatus @default(DRAFT)
  createdById String          @map("created_by_id")
  createdBy   User            @relation("CycleCountCreator", fields: [createdById], references: [id])
  approvedById String?        @map("approved_by_id")
  approvedBy  User?           @relation("CycleCountApprover", fields: [approvedById], references: [id])
  approvedAt  DateTime?       @map("approved_at")
  remarks     String?
  lines       CycleCountLine[]
  createdAt   DateTime        @default(now()) @map("created_at")
  updatedAt   DateTime        @updatedAt @map("updated_at")

  @@index([storeId, status])
  @@map("cycle_counts")
}

model CycleCountLine {
  id               String     @id @default(uuid())
  cycleCountId     String     @map("cycle_count_id")
  cycleCount       CycleCount @relation(fields: [cycleCountId], references: [id], onDelete: Cascade)
  materialId       String     @map("material_id")
  material         Material   @relation(fields: [materialId], references: [id])
  systemQuantity   Int        @map("system_quantity")
  physicalQuantity Int?       @map("physical_quantity")
  variance         Int        @default(0)
  varianceReason   String?    @map("variance_reason")
  createdAt        DateTime   @default(now()) @map("created_at")
  updatedAt        DateTime   @updatedAt @map("updated_at")

  @@unique([cycleCountId, materialId])
  @@index([materialId])
  @@map("cycle_count_lines")
}

model GoodsReceipt {
  id                String       @id @default(uuid())
  receiptCode       String       @unique @map("receipt_code")
  materialId        String       @map("material_id")
  material          Material     @relation(fields: [materialId], references: [id])
  storeId           String       @map("store_id")
  store             Store        @relation(fields: [storeId], references: [id])
  supplierId        String?      @map("supplier_id")
  supplier          Supplier?    @relation(fields: [supplierId], references: [id])
  purchaseOrderId   String?      @map("purchase_order_id")
  purchaseOrder     PurchaseOrder? @relation(fields: [purchaseOrderId], references: [id])
  purchaseOrderLineId String?    @map("purchase_order_line_id")
  purchaseOrderLine PurchaseOrderLine? @relation(fields: [purchaseOrderLineId], references: [id])
  quantityReceived  Int          @map("quantity_received")
  quantityAccepted  Int          @default(0) @map("quantity_accepted")
  quantityRejected  Int          @default(0) @map("quantity_rejected")
  condition         String?
  lotNumber         String?      @map("lot_number")
  batchNumber       String?      @map("batch_number")
  expiryDate        DateTime?    @map("expiry_date")
  serialNumber      String?      @map("serial_number")
  deliveryReference String?      @map("delivery_reference")
  status            ReceiptStatus @default(DRAFT)
  createdById       String       @map("created_by_id")
  createdBy         User         @relation("ReceiptCreator", fields: [createdById], references: [id])
  inspectedById     String?      @map("inspected_by_id")
  inspectedBy       User?        @relation("ReceiptInspector", fields: [inspectedById], references: [id])
  inspectedAt       DateTime?    @map("inspected_at")
  postedById        String?      @map("posted_by_id")
  postedBy          User?        @relation("ReceiptPoster", fields: [postedById], references: [id])
  postedAt          DateTime?    @map("posted_at")
  rejectionReasonCode String?     @map("rejection_reason_code")
  remarks           String?
  createdAt         DateTime     @default(now()) @map("created_at")
  updatedAt         DateTime     @updatedAt @map("updated_at")

  @@index([storeId, status])
  @@index([supplierId])
  @@index([purchaseOrderId])
  @@index([purchaseOrderLineId])
  @@map("goods_receipts")
}

model PurchaseOrder {
  id             String             @id @default(uuid())
  orderNumber    String             @unique @map("order_number")
  supplierId     String             @map("supplier_id")
  supplier       Supplier           @relation(fields: [supplierId], references: [id])
  storeId        String             @map("store_id")
  store          Store              @relation(fields: [storeId], references: [id])
  status         PurchaseOrderStatus @default(DRAFT)
  purpose        String?
  remarks        String?
  createdById    String             @map("created_by_id")
  createdBy      User               @relation("PurchaseOrderCreator", fields: [createdById], references: [id])
  approvedById   String?            @map("approved_by_id")
  approvedBy     User?              @relation("PurchaseOrderApprover", fields: [approvedById], references: [id])
  approvedAt     DateTime?          @map("approved_at")
  submittedAt    DateTime?          @map("submitted_at")
  cancelledAt    DateTime?          @map("cancelled_at")
  lines          PurchaseOrderLine[]
  goodsReceipts  GoodsReceipt[]
  createdAt      DateTime           @default(now()) @map("created_at")
  updatedAt      DateTime           @updatedAt @map("updated_at")

  @@index([supplierId, status])
  @@index([storeId, status])
  @@map("purchase_orders")
}

model PurchaseOrderLine {
  id               String        @id @default(uuid())
  purchaseOrderId  String        @map("purchase_order_id")
  purchaseOrder    PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  materialId       String        @map("material_id")
  material         Material      @relation(fields: [materialId], references: [id])
  quantityOrdered  Int           @map("quantity_ordered")
  quantityReceived Int           @default(0) @map("quantity_received")
  unitPrice        Decimal?      @map("unit_price") @db.Decimal(12, 2)
  remarks          String?
  goodsReceipts    GoodsReceipt[]

  @@unique([purchaseOrderId, materialId])
  @@index([materialId])
  @@map("purchase_order_lines")
}

model MaterialReturn {
  id            String              @id @default(uuid())
  returnCode    String              @unique @map("return_code")
  requestId     String              @map("request_id")
  request       MaterialRequest     @relation(fields: [requestId], references: [id])
  requestItemId String              @map("request_item_id")
  requestItem   MaterialRequestItem @relation(fields: [requestItemId], references: [id])
  materialId    String              @map("material_id")
  material     Material             @relation(fields: [materialId], references: [id])
  storeId       String              @map("store_id")
  store         Store               @relation(fields: [storeId], references: [id])
  quantity      Int
  condition     String?
  lotNumber     String?              @map("lot_number")
  batchNumber   String?              @map("batch_number")
  expiryDate    DateTime?            @map("expiry_date")
  serialNumber  String?              @map("serial_number")
  disposition   ReturnDisposition?
  status        MaterialReturnStatus @default(DRAFT)
  createdById   String               @map("created_by_id")
  createdBy     User                 @relation("ReturnCreator", fields: [createdById], references: [id])
  inspectedById String?              @map("inspected_by_id")
  inspectedBy   User?                @relation("ReturnInspector", fields: [inspectedById], references: [id])
  inspectedAt   DateTime?            @map("inspected_at")
  postedById    String?              @map("posted_by_id")
  postedBy      User?                @relation("ReturnPoster", fields: [postedById], references: [id])
  postedAt      DateTime?             @map("posted_at")
  remarks       String?
  createdAt     DateTime              @default(now()) @map("created_at")
  updatedAt     DateTime              @updatedAt @map("updated_at")

  @@index([storeId, status])
  @@index([requestId, requestItemId])
  @@map("material_returns")
}

model InventoryTransfer {
  id                 String         @id @default(uuid())
  transferCode       String         @unique @map("transfer_code")
  idempotencyKey     String?        @unique @map("idempotency_key")
  materialId         String         @map("material_id")
  material           Material       @relation(fields: [materialId], references: [id])
  quantity           Int
  lotNumber          String?        @map("lot_number")
  batchNumber        String?        @map("batch_number")
  expiryDate         DateTime?      @map("expiry_date")
  sourceStoreId      String         @map("source_store_id")
  sourceStore        Store          @relation("TransferSource", fields: [sourceStoreId], references: [id])
  destinationStoreId String         @map("destination_store_id")
  destinationStore   Store          @relation("TransferDestination", fields: [destinationStoreId], references: [id])
  status             TransferStatus @default(DRAFT)
  purpose            String?
  remarks            String?
  requestedById      String         @map("requested_by_id")
  requestedBy        User           @relation("TransferRequester", fields: [requestedById], references: [id])
  dispatchedById     String?        @map("dispatched_by_id")
  dispatchedBy       User?          @relation("TransferDispatcher", fields: [dispatchedById], references: [id])
  dispatchedAt       DateTime?      @map("dispatched_at")
  receivedById       String?        @map("received_by_id")
  receivedBy         User?          @relation("TransferReceiver", fields: [receivedById], references: [id])
  receivedAt         DateTime?      @map("received_at")
  cancelledById      String?        @map("cancelled_by_id")
  cancelledBy        User?          @relation("TransferCanceller", fields: [cancelledById], references: [id])
  cancelledAt        DateTime?      @map("cancelled_at")
  cancellationReasonCode String?    @map("cancellation_reason_code")
  cancellationRemarks String?       @map("cancellation_remarks")
  createdAt          DateTime       @default(now()) @map("created_at")
  updatedAt          DateTime       @updatedAt @map("updated_at")

  @@index([sourceStoreId, status])
  @@index([destinationStoreId, status])
  @@map("inventory_transfers")
}

model InventoryTransaction {
  id              String          @id @default(uuid())
  transactionCode String          @unique @map("transaction_code")
  idempotencyKey  String?         @unique @map("idempotency_key")
  type            TransactionType
  quantity        Int
  lotNumber       String?         @map("lot_number")
  batchNumber     String?         @map("batch_number")
  expiryDate      DateTime?       @map("expiry_date")
  serialNumber    String?         @map("serial_number")
  condition       InventoryCondition?
  unitPrice       Decimal?        @map("unit_price") @db.Decimal(12, 2)
  purpose         String?
  remarks         String?

  materialId String   @map("material_id")
  material   Material @relation(fields: [materialId], references: [id])

  storeId String? @map("store_id")
  store   Store?  @relation("TransactionStore", fields: [storeId], references: [id])

  requestId String?          @map("request_id")
  request   MaterialRequest? @relation(fields: [requestId], references: [id])

  requestItemId String?             @map("request_item_id")
  requestItem   MaterialRequestItem? @relation(fields: [requestItemId], references: [id], onDelete: SetNull)

  supplierId String?   @map("supplier_id")
  supplier   Supplier? @relation(fields: [supplierId], references: [id])

  employeeId String?   @map("employee_id")
  employee   Employee? @relation(fields: [employeeId], references: [id])

  departmentId String?     @map("department_id")
  department   Department? @relation(fields: [departmentId], references: [id])

  issuedById String? @map("issued_by_id")
  issuedBy   User?   @relation("IssuedBy", fields: [issuedById], references: [id])

  approvedById String? @map("approved_by_id")
  approvedBy   User?   @relation("ApprovedBy", fields: [approvedById], references: [id])

  createdAt DateTime @default(now()) @map("created_at")

  @@index([requestItemId])
  @@index([storeId, createdAt])
  @@index([type, createdAt])
  @@map("inventory_transactions")
}

model AuditLog {
  id            String   @id @default(uuid())
  userId        String?  @map("user_id")
  user          User?    @relation(fields: [userId], references: [id])
  actorRole     String?  @map("actor_role")
  storeId       String?  @map("store_id")
  deviceId      String?  @map("device_id")
  action        String
  module        String
  entityType    String?  @map("entity_type")
  entityId      String?  @map("entity_id")
  correlationId String   @unique @default(uuid()) @map("correlation_id")
  reversalOfId  String?  @map("reversal_of_id")
  reversalOf    AuditLog? @relation("AuditLogReversal", fields: [reversalOfId], references: [id])
  reversals     AuditLog[] @relation("AuditLogReversal")
  details       String?
  reason        String?
  source        String   @default("api")
  ipAddress     String?  @map("ip_address")
  userAgent     String?  @map("user_agent")
  beforeData    Json?    @map("before_data")
  afterData     Json?    @map("after_data")
  createdAt     DateTime @default(now()) @map("created_at")

  @@index([correlationId])
  @@index([entityType, entityId])
  @@index([storeId, createdAt])
  @@index([deviceId, createdAt])
  @@index([reversalOfId])
  @@index([createdAt])
  @@map("audit_logs")
}

enum OutboxEventStatus {
  PENDING
  PROCESSING
  PROCESSED
  FAILED
}

model OutboxEvent {
  id            String           @id @default(uuid())
  eventKey      String           @unique @map("event_key")
  eventType     String           @map("event_type")
  payload       Json
  status        OutboxEventStatus @default(PENDING)
  attempts      Int              @default(0)
  availableAt   DateTime         @default(now()) @map("available_at")
  processedAt   DateTime?        @map("processed_at")
  lastError     String?          @map("last_error")
  createdAt     DateTime         @default(now()) @map("created_at")
  updatedAt     DateTime         @updatedAt @map("updated_at")

  @@index([status, availableAt])
  @@map("outbox_events")
}

enum NotificationType {
  REQUEST_SUBMITTED
  REQUEST_APPROVED
  REQUEST_REJECTED
  REQUEST_ISSUED
  LOW_STOCK_ALERT
  STOCK_IN_RECORDED
}

model Notification {
  id        String           @id @default(uuid())
  userId    String           @map("user_id")
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      NotificationType
  title     String
  message   String
  isRead    Boolean          @default(false) @map("is_read")
  metadata  Json?            // { requestId, requestNumber, materialName, etc. }
  createdAt DateTime         @default(now()) @map("created_at")

  @@map("notifications")
}
