// Prisma schema for the University ERP system.
// Phase 1.1 adds the first real model: OrganizationUnit — the dynamic org
// tree every other module (Store, User, Request routing) hangs off of.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum OrganizationUnitType {
  UNIVERSITY
  COLLEGE
  DEPARTMENT
  OFFICE
  BUREAU
  DIRECTORATE
  UNIT
}

enum OrganizationUnitStatus {
  ACTIVE
  INACTIVE
}

model OrganizationUnit {
  id     String                 @id @default(uuid())
  name   String
  type   OrganizationUnitType
  status OrganizationUnitStatus @default(ACTIVE)

  parentId String?            @map("parent_id")
  parent   OrganizationUnit?  @relation("OrganizationHierarchy", fields: [parentId], references: [id])
  children OrganizationUnit[] @relation("OrganizationHierarchy")

  users User[]
  stores Store[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([parentId])
  @@map("organization_units")
}

enum UserStatus {
  ACTIVE
  INACTIVE
}

model User {
  id           String     @id @default(uuid())
  fullName     String     @map("full_name")
  email        String     @unique
  phone        String?
  passwordHash String     @map("password_hash")
  status       UserStatus @default(ACTIVE)

  organizationId String           @map("organization_id")
  organization   OrganizationUnit @relation(fields: [organizationId], references: [id])

  refreshTokens       RefreshToken[]
  passwordResetTokens PasswordResetToken[]
  userRoles           UserRole[]
  managedStores       Store[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([organizationId])
  @@map("users")
}

// One row per issued refresh token so any single session/device can be
// revoked (logout) without invalidating every other session, and so token
// rotation can detect reuse of an already-rotated token.
model RefreshToken {
  id        String    @id @default(uuid())
  tokenHash String    @unique @map("token_hash")
  userId    String    @map("user_id")
  user      User      @relation(fields: [userId], references: [id])
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime  @default(now()) @map("created_at")

  @@index([userId])
  @@map("refresh_tokens")
}

model PasswordResetToken {
  id        String    @id @default(uuid())
  tokenHash String    @unique @map("token_hash")
  userId    String    @map("user_id")
  user      User      @relation(fields: [userId], references: [id])
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  @@index([userId])
  @@map("password_reset_tokens")
}

enum ScopeType {
  GLOBAL
  ORGANIZATION
  STORE
}

model Role {
  id          String  @id @default(uuid())
  code        String  @unique
  name        String
  description String?
  // Seeded system roles (System Administrator, Store Manager, ...) can't be
  // deleted — only custom roles created later can be.
  isSystem    Boolean @default(false) @map("is_system")

  rolePermissions RolePermission[]
  userRoles       UserRole[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("roles")
}

model Permission {
  id          String  @id @default(uuid())
  // Namespaced key, e.g. "inventory.view", "transfer.approve"
  key         String  @unique
  description String?

  rolePermissions RolePermission[]

  createdAt DateTime @default(now()) @map("created_at")

  @@map("permissions")
}

model RolePermission {
  id           String     @id @default(uuid())
  roleId       String     @map("role_id")
  role         Role       @relation(fields: [roleId], references: [id])
  permissionId String     @map("permission_id")
  permission   Permission @relation(fields: [permissionId], references: [id])

  createdAt DateTime @default(now()) @map("created_at")

  @@unique([roleId, permissionId])
  @@map("role_permissions")
}

// Assigns a role to a user, scoped to either everything (GLOBAL), a specific
// organization unit and everything under it (ORGANIZATION), or a specific
// store only (STORE). scopeId is intentionally a plain string, not a foreign
// key: it points at OrganizationUnit.id when scopeType=ORGANIZATION, or at a
// future Store.id when scopeType=STORE (the Store module lands in Phase 2.1),
// and is null when scopeType=GLOBAL.
model UserRole {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  user      User      @relation(fields: [userId], references: [id])
  roleId    String    @map("role_id")
  role      Role      @relation(fields: [roleId], references: [id])
  scopeType ScopeType @map("scope_type")
  scopeId   String?   @map("scope_id")

  createdAt DateTime @default(now()) @map("created_at")

  @@unique([userId, roleId, scopeType, scopeId])
  @@index([userId])
  @@map("user_roles")
}

enum StoreStatus {
  ACTIVE
  INACTIVE
}

model Store {
  id       String      @id @default(uuid())
  name     String
  code     String      @unique
  location String?
  status   StoreStatus @default(ACTIVE)

  organizationId String           @map("organization_id")
  organization   OrganizationUnit @relation(fields: [organizationId], references: [id])

  managerId String? @map("manager_id")
  manager   User?   @relation(fields: [managerId], references: [id])

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([organizationId])
  @@index([managerId])
  @@map("stores")
}
