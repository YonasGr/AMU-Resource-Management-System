{
  "name": "university-erp",
  "private": true,
  "version": "0.1.0",
  "description": "University Inventory, Store, Asset and Workflow Management System",
  "scripts": {
    "dev:backend": "pnpm --filter backend run start:dev",
    "dev:frontend": "pnpm --filter frontend run dev",
    "build:backend": "pnpm --filter backend run build",
    "build:frontend": "pnpm --filter frontend run build",
    "docker:up": "docker compose up --build",
    "docker:down": "docker compose down"
  },
  "packageManager": "pnpm@12.14.0",
  "devDependencies": {
    "@mermaid-js/mermaid-cli": "^12.0.0",
    "prisma-erd-generator": "^3.2.1",
    "puppeteer": "^25.14.0"
  }
}
